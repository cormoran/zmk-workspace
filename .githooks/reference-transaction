#!/usr/bin/env bash
# Require every newly created local branch to start at the selected GitHub main.
set -euo pipefail

state="$1"
if [[ "$state" != "prepared" ]]; then
    exit 0
fi

remotes="$(git remote)"
if grep -qx 'origin' <<<"$remotes"; then
    remote='origin'
elif grep -qx 'cormoran' <<<"$remotes"; then
    remote='cormoran'
else
    echo 'new branches require an origin or cormoran remote' >&2
    exit 1
fi

baseline="refs/remotes/$remote/main"
if ! baseline_sha="$(git rev-parse --verify --quiet "$baseline")"; then
    echo "new branches require fetched $remote/main" >&2
    exit 1
fi

zero='0000000000000000000000000000000000000000'
while read -r old_sha new_sha ref; do
    if [[ "$ref" == refs/heads/* && "$old_sha" == "$zero" && "$new_sha" != "$baseline_sha" ]]; then
        echo "refusing to create ${ref#refs/heads/}: fetch $remote and branch from $remote/main" >&2
        exit 1
    fi
done
